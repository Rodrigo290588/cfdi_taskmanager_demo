# ============================================================================
# Platfi Intelligence · CFDI Task Manager Demo - ENVIRONMENT TEMPLATE (.env.example)
# ============================================================================
# COPIAR ESTE ARCHIVO → .env.local / .env.production / .env.test
# ¡NUNCA COMMITEAR los archivos rellenados con SECRETOS REALES!
# El archivo .gitignore (L33-L36) está configurado para ignorar: .env* excepto .env.example y .env.test
# ============================================================================
#
# Jerarquía de carga Next.js 16 (primero gana, de MÁS prioritario → MENOS):
#   1. .env.{NODE_ENV}.local     → p. ej. .env.production.local (SUPER SECRETO, nunca commit)
#   2. .env.local                → localhost dev (variables que cambian por máquina)
#   3. .env.{NODE_ENV}           → .env.production, .env.development, .env.test
#   4. .env                      → compartidos (NUNCA poner SECRETS de producción aquí)
#
# Para generar SECRETS criptográficamente seguros:
#   npx auth secret       # → 64 chars hex (NextAuth v5 / Auth.js)
#   openssl rand -hex 32  # → 64 chars hex (AES-256 key)

# ============================================================
# 1. BASE DE DATOS (PostgreSQL · Prisma ORM)
# ============================================================
# Producción: usar connection string con SSL require + pool_timeout 60s
#   DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require&connection_limit=50&pool_timeout=60"
# Desarrollo local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/platfi_intelligence_demo"

# ============================================================
# 2. AUTENTICACIÓN (NextAuth v5 beta · Auth.js v5 core)
# ============================================================
# 🔴 2.1 SECRETS (NO COMMITEAR NUNCA los valores reales. Rotar antes de GA)
#   - AUTH_SECRET y NEXTAUTH_SECRET DEBEN TENER EL MISMO VALOR.
#   - Longitud mínima: 32 chars (recomendado ≥ 64 chars hex).
AUTH_SECRET=_REPLACE_WITH_NPX_AUTH_SECRET_64CHARS_HEX_
NEXTAUTH_SECRET=_REPLACE_WITH_SAME_64CHARS_HEX_

# 🔴 2.2 URL PÚBLICA DE LA APLICACIÓN
#   Sin trailing slash. Incluye puerto si es no-standard.
#   Valida PROTOCOLO (http en dev, https SIEMPRE EN PROD).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ⚠️ 2.3 HOSTS PERMITIDOS (WHITELIST AUTH TRUST HOST)
# - SEPARADOR: coma (,) SIN espacios alrededor.
# - EN PRODUCCIÓN: listar SOLAMENTE los dominios/hostnames reales (puerto si aplica).
# - EN PRODUCCIÓN: NO incluir localhost, 127.0.0.1, 10.x.x.x, 192.168.x.x.
# - El cálculo en src/lib/auth.ts y src/auth-middleware.ts CHEQUEA ESTA LISTA PRIMERO.
#   Valores DEFAULT (si la variable está VACÍA): localhost:3000, localhost:3001, 127.0.0.1:3000, 127.0.0.1:3001, 10.10.33.143:3000, 10.10.33.143:3001
PUBLIC_HOSTS_ALLOWLIST="app.tu-empresa.com,api.tu-empresa.com,localhost:3000,localhost:3001,127.0.0.1:3000"

# 🚨 2.4 BYPASS TRUST HOST (USAR SOLO COMO KILL-SWITCH TEMPORAL)
#   Por defecto: NO DEFINIDA en PROD. Solo setear "true" si hay emergencia UntrustedHost
#   y PUBLIC_HOSTS_ALLOWLIST no puede ser actualizado inmediatamente. APAGAR después.
AUTH_TRUST_HOST=false
NEXTAUTH_TRUST_HOST=false

# 🛑 2.5 FEATURE_STRICT_AUTH_TRUST (Kill-Switch GLOBAL - MODO RECOMENDADO GA = 1)
#   "1" = ignora completamente AUTH_TRUST_HOST=true  → solo confía en PUBLIC_HOSTS_ALLOWLIST + AUTH_URL host.
#   "0" o NO DEFINIDA → modo default (dev amigable).
#   EN PROD: DEJAR EN 1.
FEATURE_STRICT_AUTH_TRUST=0

# ============================================================
# 3. OAUTH 2.0 · INICIO DE SESIÓN GOOGLE
# ============================================================
# Consola Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorized Redirect URIs (OJO, el path sigue el formato NextAuth):
#     DEV:  http://localhost:3000/api/auth/callback/google
#     PROD: https://app.tu-empresa.com/api/auth/callback/google
GOOGLE_CLIENT_ID="_REPLACE_ME_xxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="_REPLACE_ME_GOOGLE_CLOUD_SECRET"

# API Key pública de Google Maps / Places / SAT consulta (opcional):
GOOGLE_API_KEY="_OPTIONAL_REPLACE_ME_"

# ============================================================
# 4. CIFRADO AES-256-GCM (XML CFDI · Tokens · Secrets columna)
# ============================================================
# Longitud EXACTA: 64 caracteres hexadecimales (32 bytes → AES-256).
# Rotar este secret IMPLICA re-encryptar TODOS los blobs XML (script dedicado).
DATA_ENCRYPTION_KEY="_REPLACE_WITH_OPENSSL_RAND_HEX_32_BYTES_64_CHARS_"
PROVIDER_CFDI_XML_ENCRYPTION_KEY="_REPLACE_WITH_SAME_AES_256_KEY_"
PROVIDER_CFDI_XML_KEY_VERSION="v1"

# ============================================================
# 5. M2M · Servicios Externos (Client ID / Secret · JWT tokens)
# ============================================================
# Longitud M2M_JWT_SECRET: >= 64 chars (HS-512).
M2M_JWT_SECRET="_REPLACE_WITH_64CHARS_PLUS_JWT_HS512_KEY_"
M2M_JWT_ISSUER="cfdi-platform"
M2M_JWT_AUDIENCE="cfdi-external-users"
M2M_JWT_EXPIRES_IN="5m"

# JSON array con los clients M2M autorizados (scope granular).
# NO COMMITEAR en .env de PROD; pasar como Secret Manager.
M2M_OAUTH_CLIENTS_JSON='[{"clientId":"demo-client","clientSecret":"demo-secret-CHANGE-BEFORE-PROD","organizationId":"_REPLACE_TENANT_UUID","scopes":["users:create","payments:update","cfdi.import"]}]'

# API Key legacy (handlers /api/cfdi/import). Rotar en GA.
CFDI_IMPORT_API_KEY="dev-import-key-12345"
API_KEY_SECRET="_REPLACE_WITH_STRONG_KEY_"

# ============================================================
# 6. REDIS · BullMQ Workers (Colas de trabajo SAT, CFDI bulk, reportes)
# ============================================================
# En PROD: Redis con AUTH password + TLS. URL formato: redis://user:pass@host:6379
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ============================================================
# 7. SAT · Data Source Público 69-B (Listado completo RFC + nombres)
# ============================================================
SAT_69B_SOURCE_URL="https://wu1agsprosta001.blob.core.windows.net/agsc-publicaciones/Datos_abiertos/Documents_AGAFF/Listado_completo_69-B.csv"

# ============================================================
# 8. MISC · Runtime Flags · Feature Toggles
# ============================================================
# Puerto DEV server (default 3000). En PROD esto lo maneja Vercel/container: PORT=80/443.
PORT=3000

# Deshabilitar bypasses seguros DEV en PROD:
INVOICE_PDF_ENABLE_FILE_PARAM_IN_DEV=false
