# 1. BASE DE DATOS (PostgreSQL)
# Formato: postgresql://[usuario]:[contraseña]@[servidor o IP]:[puerto]/[nombre_base_datos]
DATABASE_URL="postgresql://postgres:VmW$4e^npNPh2VX'0jv%40@localhost:5432/BFI"

# 2. AUTENTICACIÓN Y SEGURIDAD (Sesiones de usuario)
# Confianza en el host para permitir sesiones (Obligatorio en producción)
AUTH_TRUST_HOST="true"
# La dirección web oficial donde los usuarios entrarán al sistema (ej. https://sistema.itcomplements.com)
NEXTAUTH_URL="https://midominio.com"
# Una clave secreta muy larga para proteger las sesiones (puedes generar una aleatoria)
NEXTAUTH_SECRET="x8vFm9!pQ2zL5#kR4@wT7*nB6$yC3^jH"

# 3. ACCESO CON GOOGLE (Opcional, dejar vacío si no se usa)
# Claves proporcionadas por la consola de Google Cloud para iniciar sesión con Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. GESTOR DE TAREAS Y DESCARGAS (Redis)
# Dirección de conexión para el sistema que maneja las descargas en segundo plano
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# 5. SEGURIDAD DE DATOS SENSIBLES (Claves SAT)
# Clave maestra de 64 caracteres (letras de la 'a' a la 'f' y números) para encriptar contraseñas del SAT
# IMPORTANTE: Si esta clave se pierde, no se podrán desencriptar las contraseñas guardadas.
