# ==============================================================================
# CONFIGURACIÓN PARA PRODUCCIÓN (Servidor Definitivo)
# No incluyas secretos reales en esta plantilla; usa .env en el servidor y mantenlo fuera de Git.
# ==============================================================================

# 1. BASE DE DATOS (PostgreSQL)
# Formato: postgresql://[usuario]:[contraseña]@[servidor o IP]:[puerto]/[nombre_base_datos]
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/BASE_DE_DATOS"

# 2. AUTENTICACIÓN Y SEGURIDAD (Sesiones de usuario)
# Confianza en el host para permitir sesiones (Obligatorio en producción)
AUTH_TRUST_HOST="true"
# La dirección web oficial donde los usuarios entrarán al sistema (ej. https://sistema.itcomplements.com)
NEXTAUTH_URL="https://tu-dominio.example"
# Una clave secreta muy larga para proteger las sesiones (puedes generar una aleatoria)
NEXTAUTH_SECRET="GENERAR_64_CARACTERES_HEX"

# 3. ACCESO CON GOOGLE (Opcional, dejar vacío si no se usa)
# Claves proporcionadas por la consola de Google Cloud para iniciar sesión con Google
GOOGLE_CLIENT_ID="CONFIGURAR_EN_GOOGLE_CLOUD"
GOOGLE_CLIENT_SECRET="CONFIGURAR_EN_GOOGLE_CLOUD"

# 4. GESTOR DE TAREAS Y DESCARGAS (Redis)
# Dirección de conexión para el sistema que maneja las descargas en segundo plano
REDIS_URL="redis://USUARIO:CONTRASENA@HOST:6379"
REDIS_HOST="HOST_DE_REDIS"
REDIS_PORT="6379"

# 5. SEGURIDAD DE DATOS SENSIBLES (Claves SAT)
# Clave maestra de 64 caracteres (letras de la 'a' a la 'f' y números) para encriptar contraseñas del SAT
# IMPORTANTE: Si esta clave se pierde, no se podrán desencriptar las contraseñas guardadas.
DATA_ENCRYPTION_KEY="GENERAR_64_CARACTERES_HEX_Y_CONSERVAR"

# 6. SEGURIDAD DE PROCESOS INTERNOS Y WORKERS
# Clave para firmar las llaves de acceso de los usuarios
API_KEY_SECRET="GENERAR_SECRETO_ALEATORIO"
# Contraseña para que el descargador automático de CFDI tenga permiso de guardar los datos
CFDI_IMPORT_API_KEY="GENERAR_SECRETO_ALEATORIO"
# Clave secreta para la comunicación entre los procesos internos (Workers) y el sistema principal
M2M_JWT_SECRET="GENERAR_32_BYTES_O_MAS"

# 7. CIFRADO DE XML CFDI (llaves independientes; conservar para descifrar datos existentes)
INVOICE_XML_ENCRYPTION_KEY="GENERAR_64_CARACTERES_HEX_Y_CONSERVAR"
PROVIDER_CFDI_XML_ENCRYPTION_KEY="GENERAR_64_CARACTERES_HEX_Y_CONSERVAR"
