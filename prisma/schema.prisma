generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?     @map("email_verified")
  image          String?
  password       String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  systemRole     SystemRole    @default(USER) @map("system_role")
  onboardingStep String?       @default("initial")
  onboardingData Json?         @default("{}")
  accounts       Account[]
  apiKeys        ApiKey[]
  invoices       Invoice[]
  providerUploadedCfdis ProviderUploadedCfdi[] @relation("ProviderUploadedCfdiUser")
  satInvoices    SatInvoice[]
  memberships    Member[]
  organizations  Organization?
  sessions       Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Organization {
  id                       String         @id @default(cuid())
  name                     String
  slug                     String         @unique
  logo                     String?
  description              String?
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  ownerId                  String?        @unique
  onboardingCompleted      Boolean        @default(false)
  setupRequirements        Json           @default("{\"minUsers\": 2, \"minCompanies\": 1}")
  operationalAccessEnabled Boolean        @default(false)
  systemSettings           Json?          @default("{}") @map("system_settings")
  address                  String?
  city                     String?
  state                    String?
  postalCode               String?        @map("postal_code")
  country                  String?        @default("México")
  phone                    String?
  contactEmail             String?        @map("contact_email")
  businessDescription      String?        @map("business_description")
  website                  String?
  industry                 String?
  companySize              String?        @map("company_size")
  foundedYear              Int?           @map("founded_year")
  taxId                    String?        @map("tax_id")
  businessType             String?        @map("business_type")
  fiscalEntities           FiscalEntity[]
  members                  Member[]
  machineClients           MachineClient[]
  providerUploadedCfdis    ProviderUploadedCfdi[]
  providerReceivedCfdiDailySummaries ProviderReceivedCfdiDailySummary[]
  customRoles              CustomRole[]
  companyAccesses          CompanyAccess[]
  satCredentials           SatCredential[]
  users                    User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([onboardingCompleted])
  @@index([operationalAccessEnabled])
  @@map("organizations")
}

model MachineClient {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  clientId         String       @unique @map("client_id")
  clientSecretHash String       @map("client_secret_hash")
  description      String?
  scopes           String[]     @default(["users:create"])
  allowedIps       String[]     @default([]) @map("allowed_ips")
  isActive         Boolean      @default(true) @map("is_active")
  expiresAt        DateTime?    @map("expires_at")
  lastUsedAt       DateTime?    @map("last_used_at")
  lastUsedIp       String?      @map("last_used_ip")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  createdByUserId  String?      @map("created_by_user_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("machine_clients")
}

model CustomRole {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  name                String
  description         String?
  canViewEmission     Boolean      @default(true)  @map("can_view_emission")
  canViewReception    Boolean      @default(true)  @map("can_view_reception")
  canViewPayroll      Boolean      @default(true)  @map("can_view_payroll")
  canViewSatPortal    Boolean      @default(true)  @map("can_view_sat_portal")
  canViewMassDownloads Boolean      @default(true)  @map("can_view_mass_downloads")
  canManageOrg        Boolean      @default(false) @map("can_manage_org")
  granularPermissions Json?        @default("{}")  @map("granular_permissions")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members             Member[]
  companyAccesses     CompanyAccess[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model Member {
  id                  String       @id @default(cuid())
  userId              String       @map("user_id")
  organizationId      String       @map("organization_id")
  role                MemberRole   @default(VIEWER)
  customRoleId        String?      @map("custom_role_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  status              String       @default("PENDING")
  approvedBy          String?
  approvedAt          DateTime?    @db.Timestamp(6)
  invitationTokenHash String?      @map("invitation_token_hash")
  invitationExpiresAt DateTime?    @db.Timestamp(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole          CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  companyAccesses     CompanyAccess[]
  providerUploadedCfdis ProviderUploadedCfdi[]
  canViewEmission     Boolean      @default(true)  @map("can_view_emission")
  canViewReception    Boolean      @default(true)  @map("can_view_reception")
  canViewPayroll      Boolean      @default(true)  @map("can_view_payroll")
  canViewSatPortal    Boolean      @default(true)  @map("can_view_sat_portal")
  canViewMassDownloads Boolean      @default(true)  @map("can_view_mass_downloads")
  canManageOrg        Boolean      @default(false) @map("can_manage_org")
  granularPermissions Json?        @default("{}")  @map("granular_permissions")
  providerRfc         String?      @map("provider_rfc")
  providerName        String?      @map("provider_name")
  providerUploadBlockedAt DateTime? @map("provider_upload_blocked_at")
  providerUploadBlockedReason String? @map("provider_upload_blocked_reason")
  providerUploadBlockedBySystem Boolean @default(false) @map("provider_upload_blocked_by_system")

  @@unique([userId, organizationId])
  @@index([invitationTokenHash])
  @@index([status])
  @@index([organizationId, providerRfc])
  @@index([providerUploadBlockedBySystem])
  @@map("members")
}

model FiscalEntity {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  rfc            String       @unique
  businessName   String       @map("business_name")
  taxRegime      String       @map("tax_regime")
  postalCode     String       @map("postal_code")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  satInvoices    SatInvoice[]

  @@map("fiscal_entities")
}

model Invoice {
  id                   String        @id @default(cuid())
  userId               String?       @map("user_id")
  issuerFiscalEntityId String        @map("issuer_fiscal_entity_id")
  uuid                 String        @unique
  cfdiType             CfdiType      @map("cfdi_type")
  series               String?
  folio                String?
  currency             String        @default("MXN")
  exchangeRate         Float?        @map("exchange_rate")
  status               InvoiceStatus @default(ACTIVE)
  satStatus            SatStatus     @default(VIGENTE) @map("sat_status")
  issuerRfc            String        @map("issuer_rfc")
  issuerName           String        @map("issuer_name")
  receiverRfc          String        @map("receiver_rfc")
  receiverName         String        @map("receiver_name")
  subtotal             Decimal       @db.Decimal(15, 2)
  discount             Decimal       @default(0) @db.Decimal(15, 2)
  total                Decimal       @db.Decimal(15, 2)
  ivaTransferred       Decimal       @default(0) @map("iva_transferred") @db.Decimal(15, 2)
  ivaWithheld          Decimal       @default(0) @map("iva_withheld") @db.Decimal(15, 2)
  isrWithheld          Decimal       @default(0) @map("isr_withheld") @db.Decimal(15, 2)
  iepsWithheld         Decimal       @default(0) @map("ieps_withheld") @db.Decimal(15, 2)
  xmlContent           String        @map("xml_content")
  pdfUrl               String?       @map("pdf_url")
  issuanceDate         DateTime      @map("issuance_date")
  certificationDate    DateTime      @map("certification_date")
  certificationPac     String        @map("certification_pac")
  paymentMethod        String        @map("payment_method")
  paymentForm          String        @map("payment_form")
  cfdiUsage            String        @map("cfdi_usage")
  placeOfExpedition    String        @map("place_of_expedition")
  exportKey            String        @default("01") @map("export_key")
  objectTaxComprobante String?       @map("object_tax_comprobante")
  paymentConditions    String?       @map("payment_conditions")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  fiscalEntity         FiscalEntity  @relation(fields: [issuerFiscalEntityId], references: [id], onDelete: Cascade)
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  concepts             InvoiceConcept[]
  relatedCfdis         InvoiceRelatedCfdi[]

  @@index([issuerFiscalEntityId])
  @@index([issuerRfc])
  @@index([receiverRfc])
  @@index([issuanceDate])
  @@index([total])
  @@map("invoices")
}

model SatInvoice {
  id                String        @id @default(cuid())
  userId            String?       @map("user_id")
  fiscalEntityId    String        @map("fiscal_entity_id")
  uuid              String        @unique
  cfdiType          CfdiType      @map("cfdi_type")
  series            String?
  folio             String?
  currency          String        @default("MXN")
  exchangeRate      Float?        @map("exchange_rate")
  status            InvoiceStatus @default(ACTIVE)
  satStatus         SatStatus     @default(VIGENTE) @map("sat_status")
  issuerRfc         String        @map("issuer_rfc")
  issuerName        String        @map("issuer_name")
  receiverRfc       String        @map("receiver_rfc")
  receiverName      String        @map("receiver_name")
  subtotal          Decimal       @db.Decimal(15, 2)
  discount          Decimal       @default(0) @db.Decimal(15, 2)
  total             Decimal       @db.Decimal(15, 2)
  ivaTrasladado     Decimal       @default(0) @map("iva_trasladado") @db.Decimal(15, 2)
  ivaRetenido       Decimal       @default(0) @map("iva_retenido") @db.Decimal(15, 2)
  isrRetenido       Decimal       @default(0) @map("isr_retenido") @db.Decimal(15, 2)
  iepsRetenido      Decimal       @default(0) @map("ieps_retenido") @db.Decimal(15, 2)
  xmlContent        String        @map("xml_content")
  pdfUrl            String?       @map("pdf_url")
  issuanceDate      DateTime      @map("issuance_date")
  certificationDate DateTime      @map("certification_date")
  certificationPac  String        @map("certification_pac")
  paymentMethod     String        @map("payment_method")
  paymentForm       String        @map("payment_form")
  usageCfdi         String        @map("usage_cfdi")
  expeditionPlace   String        @map("expedition_place")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  fiscalEntity      FiscalEntity  @relation(fields: [fiscalEntityId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fiscalEntityId])
  @@index([issuerRfc])
  @@index([receiverRfc])
  @@index([issuanceDate])
  @@index([total])
  @@map("sat_invoices")
}

model InvoiceConcept {
  id                     Int      @id @default(autoincrement())
  invoiceId              String   @map("invoice_id")
  productServiceKey      String   @map("product_service_key")
  identificationNumber   String?  @map("identification_number")
  unitQuantity           Decimal  @map("unit_quantity") @db.Decimal(18, 6)
  unitKey                String   @map("unit_key")
  unitDescription        String?  @map("unit_description")
  description            String
  unitValue              Decimal  @map("unit_value") @db.Decimal(18, 6)
  amount                 Decimal  @db.Decimal(18, 6)
  discount               Decimal  @default(0) @db.Decimal(15, 2)
  objectOfTax            String   @map("object_of_tax")
  transferredTaxesJson   Json?    @map("transferred_taxes_json")
  withheldTaxesJson      Json?    @map("withheld_taxes_json")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  invoice                Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_concepts")
}

model InvoiceRelatedCfdi {
  id           Int      @id @default(autoincrement())
  invoiceId    String   @map("invoice_id")
  relationType String   @map("relation_type")
  relatedUuid  String   @map("related_uuid")
  createdAt    DateTime @default(now()) @map("created_at")
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_related_cfdis")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  key         String    @unique
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  permissions String[]  @default(["read"])
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Company {
  id                  String        @id @default(cuid())
  name                String
  rfc                 String        @unique
  businessName        String        @map("business_name")
  legalRepresentative String?       @map("legal_representative")
  taxRegime           String        @map("tax_regime")
  postalCode          String        @map("postal_code")
  address             String?
  city                String?
  state               String?
  country             String        @default("México")
  phone               String?
  email               String?
  website             String?
  industry            String?
  employeesCount      Int?          @map("employees_count")
  incorporationDate   DateTime?     @map("incorporation_date")
  status              CompanyStatus @default(PENDING)
  approvedBy          String?       @map("approved_by")
  approvedAt          DateTime?     @map("approved_at")
  rejectionReason     String?       @map("rejection_reason")
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  createdBy           String        @map("created_by")
  updatedBy           String        @map("updated_by")
  auditLogs           AuditLog[]
  companyAccesses     CompanyAccess[]
  providerUploadedCfdis ProviderUploadedCfdi[]
  providerReceivedCfdiDailySummaries ProviderReceivedCfdiDailySummary[]
  massDownloadRequests MassDownloadRequest[]

  @@index([rfc])
  @@index([status])
  @@index([businessName])
  @@map("companies")
}

model MassDownloadRequest {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  
  receiverRfc   String?  @map("receiver_rfc")
  issuerRfc     String   @map("issuer_rfc")
  requestingRfc String   @map("requesting_rfc")
  
  requestType   String   @map("request_type")
  retrievalType String   @default("emitidos") @map("retrieval_type")
  folio         String?
  voucherType   String?  @map("voucher_type")
  status        String   @default("Todos")

  // Processing fields
  requestStatus RequestStatus @default(SOLICITADO) @map("request_status")
  satPackageId  String?       @map("sat_package_id")
  satMessage    String?       @map("sat_message") // For faultcode or success messages
  errorLog      Json?         @map("error_log")   // For detailed error tracking
  
  // Verification fields (New)
  packageIds          Json?     @map("package_ids")         // Array of package IDs generated by SAT
  verificationAttempts Int      @default(0) @map("verification_attempts")
  nextCheck           DateTime? @map("next_check")
  
  thirdPartyRfc String?  @map("third_party_rfc")
  complement    String?
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("mass_download_requests")
}

model SatMetadata {
  id                    String    @id @default(cuid())
  uuid                  String    @unique
  rfcEmisor             String    @map("rfc_emisor")
  nombreEmisor          String?   @map("nombre_emisor")
  rfcReceptor           String    @map("rfc_receptor")
  nombreReceptor        String?   @map("nombre_receptor")
  rfcPac                String?   @map("rfc_pac")
  fechaEmision          DateTime? @map("fecha_emision")
  fechaCertificacionSat DateTime? @map("fecha_certificacion_sat")
  monto                 Decimal?  @db.Decimal(18, 6)
  efectoComprobante     String?   @map("efecto_comprobante")
  estatus               String?
  fechaCancelacion      DateTime? @map("fecha_cancelacion")
  
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([rfcEmisor])
  @@index([rfcReceptor])
  @@index([fechaEmision])
  @@map("sat_metadata")
}

model CompanyAccess {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  companyId      String             @map("company_id")
  memberId       String             @map("member_id")
  role           CompanyAccessRole  @default(VIEWER)
  customRoleId   String?            @map("custom_role_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customRole     CustomRole?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([memberId, companyId])
  @@map("company_access")
}

enum CompanyAccessRole {
  ADMIN
  AUDITOR
  VIEWER
}

model AuditLog {
  id          String      @id @default(cuid())
  tableName   String      @map("table_name")
  recordId    String      @map("record_id")
  action      AuditAction
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  userId      String      @map("user_id")
  userEmail   String      @map("user_email")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  timestamp   DateTime    @default(now())
  description String?
  companyId   String?     @map("company_id")
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tableName, recordId])
  @@index([userId])
  @@index([timestamp])
  @@index([companyId])
  @@map("audit_logs")
}

model SatValidationErrorKnowledge {
  id                 String   @id @default(cuid())
  sourceSystem       String   @map("source_system")
  rawErrorHash       String   @unique @map("raw_error_hash")
  rawErrorText       String   @map("raw_error_text")
  normalizedErrorText String  @map("normalized_error_text")
  detectedCode       String   @default("N/A") @map("detected_code")
  humanMessage       String   @map("human_message")
  correctiveAction   String   @map("corrective_action")
  responsible        String
  aiProvider         String?  @map("ai_provider")
  aiModel            String?  @map("ai_model")
  usageCount         Int      @default(1) @map("usage_count")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([sourceSystem])
  @@index([detectedCode])
  @@index([lastSeenAt])
  @@map("sat_validation_error_knowledge")
}

model ProviderUploadedCfdi {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  memberId               String   @map("member_id")
  uploadedByUserId       String?  @map("uploaded_by_user_id")
  receiverCompanyId      String?  @map("receiver_company_id")
  fileName               String   @map("file_name")
  uuid                   String
  providerRfc            String   @map("provider_rfc")
  providerName           String?  @map("provider_name")
  issuerRfc              String   @map("issuer_rfc")
  issuerName             String?  @map("issuer_name")
  receiverRfc            String   @map("receiver_rfc")
  receiverName           String?  @map("receiver_name")
  cfdiType               String   @map("cfdi_type")
  series                 String?
  folio                  String?
  paymentMethod          String?  @map("payment_method")
  paymentForm            String?  @map("payment_form")
  issuerFiscalRegime     String?  @map("issuer_fiscal_regime")
  hasResicoIsrRetention  Boolean  @default(false) @map("has_resico_isr_retention")
  hasObjetoImpTaxMismatch Boolean @default(false) @map("has_objetoimp_tax_mismatch")
  objetoImpTaxMismatchReason String? @map("objetoimp_tax_mismatch_reason")
  currency               String   @default("MXN")
  subtotal               Decimal? @db.Decimal(18, 6)
  transferredTaxesTotal  Decimal? @map("transferred_taxes_total") @db.Decimal(18, 6)
  withheldTaxesTotal     Decimal? @map("withheld_taxes_total") @db.Decimal(18, 6)
  discount               Decimal? @db.Decimal(18, 6)
  total                  Decimal   @db.Decimal(18, 6)
  issuanceDate           DateTime? @map("issuance_date")
  certificationDate      DateTime? @map("certification_date")
  validationStatus       String   @default("APPROVED") @map("validation_status")
  validationAnexo20      String?  @map("validation_anexo20")
  validationSat          String?  @map("validation_sat")
  satCodigoEstatus       String?  @map("sat_codigo_estatus")
  satEstado              String?  @map("sat_estado")
  satInitialEstado       String?  @map("sat_initial_estado")
  satEsCancelable        String?  @map("sat_es_cancelable")
  satEstatusCancelacion  String?  @map("sat_estatus_cancelacion")
  satValidacionEFOS      String?  @map("sat_validacion_efos")
  satStatusLastCheckedAt DateTime? @map("sat_status_last_checked_at")
  satStatusChangedAt     DateTime? @map("sat_status_changed_at")
  satCancellationDetectedAt DateTime? @map("sat_cancellation_detected_at")
  paymentLinksJson       Json?    @map("payment_links_json")
  paymentStatusManual    String?  @map("payment_status_manual")
  paymentDateManual      DateTime? @map("payment_date_manual")
  paymentStatusUpdatedAt DateTime? @map("payment_status_updated_at")
  paymentStatusUpdatedByClientId String? @map("payment_status_updated_by_client_id")
  paymentComplementDueDate DateTime? @map("payment_complement_due_date")
  xmlSha256              String   @map("xml_sha256")
  firstValidatedAt       DateTime @default(now()) @map("first_validated_at")
  lastValidatedAt        DateTime @default(now()) @map("last_validated_at")
  uploadCount            Int      @default(1) @map("upload_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  member                 Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiverCompany        Company? @relation(fields: [receiverCompanyId], references: [id], onDelete: SetNull)
  uploadedByUser         User?    @relation("ProviderUploadedCfdiUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  xmlBlob                ProviderUploadedCfdiBlob?

  @@unique([organizationId, uuid])
  @@index([organizationId, providerRfc])
  @@index([organizationId, receiverRfc])
  @@index([organizationId, cfdiType])
  @@index([receiverCompanyId])
  @@index([issuanceDate])
  @@index([lastValidatedAt])
  @@index([validationStatus])
  @@index([satEstado])
  @@index([paymentStatusManual])
  @@index([paymentDateManual])
  @@index([paymentComplementDueDate])
  @@index([organizationId, receiverCompanyId, issuerRfc, issuanceDate], map: "provider_uploaded_cfdis_org_company_issuer_date_idx")
  @@index([organizationId, receiverCompanyId, validationStatus, cfdiType], map: "provider_uploaded_cfdis_org_company_validation_type_idx")
  @@index([organizationId, receiverCompanyId, paymentMethod, paymentForm], map: "provider_uploaded_cfdis_org_company_payment_rule_idx")
  @@index([organizationId, receiverCompanyId, issuerFiscalRegime, hasResicoIsrRetention], map: "provider_uploaded_cfdis_org_company_resico_rule_idx")
  @@index([organizationId, receiverCompanyId, hasObjetoImpTaxMismatch], map: "provider_uploaded_cfdis_org_company_objetoimp_rule_idx")
  @@index([organizationId, receiverCompanyId, satCancellationDetectedAt], map: "provider_uploaded_cfdis_org_company_cancel_detected_idx")
  @@index([validationStatus, satInitialEstado, satEstado, satStatusLastCheckedAt], map: "provider_uploaded_cfdis_sat_monitor_scan_idx")
  @@map("provider_uploaded_cfdis")
}

model ProviderUploadedCfdiBlob {
  providerUploadedCfdiId String             @id @map("provider_uploaded_cfdi_id")
  xmlCiphertext          String             @map("xml_ciphertext")
  xmlIv                  String             @map("xml_iv")
  xmlAuthTag             String             @map("xml_auth_tag")
  xmlEncryptionAlg       String             @default("aes-256-gcm") @map("xml_encryption_alg")
  xmlKeyVersion          String             @default("v1") @map("xml_key_version")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  providerUploadedCfdi   ProviderUploadedCfdi @relation(fields: [providerUploadedCfdiId], references: [id], onDelete: Cascade)

  @@map("provider_uploaded_cfdi_blobs")
}

model ProviderReceivedCfdiDailySummary {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  receiverCompanyId   String       @map("receiver_company_id")
  summaryDate         DateTime     @map("summary_date") @db.Date
  cfdiType            String       @map("cfdi_type")
  satEstado           String       @default("SIN_ESTATUS") @map("sat_estado")
  issuerRfc           String       @default("") @map("issuer_rfc")
  issuerName          String       @default("") @map("issuer_name")
  paymentMethod       String       @default("") @map("payment_method")
  paymentStatusBucket String       @default("NO_APLICA") @map("payment_status_bucket")
  cfdiCount           Int          @default(0) @map("cfdi_count")
  totalAmount         Decimal      @default(0) @map("total_amount") @db.Decimal(18, 6)
  transferredTaxesTotal Decimal    @default(0) @map("transferred_taxes_total") @db.Decimal(18, 6)
  withheldTaxesTotal  Decimal      @default(0) @map("withheld_taxes_total") @db.Decimal(18, 6)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiverCompany     Company      @relation(fields: [receiverCompanyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiverCompanyId, summaryDate, cfdiType, satEstado, issuerRfc, paymentMethod, paymentStatusBucket], map: "provider_received_cfdi_daily_summary_unique_dim_idx")
  @@index([organizationId, receiverCompanyId, summaryDate], map: "provider_received_cfdi_daily_summary_company_date_idx")
  @@index([organizationId, receiverCompanyId, cfdiType], map: "provider_received_cfdi_daily_summary_company_type_idx")
  @@index([organizationId, receiverCompanyId, satEstado], map: "provider_received_cfdi_daily_summary_company_status_idx")
  @@index([organizationId, receiverCompanyId, issuerRfc], map: "provider_received_cfdi_daily_summary_company_supplier_idx")
  @@index([organizationId, receiverCompanyId, paymentStatusBucket], map: "provider_received_cfdi_daily_summary_company_payment_bucket_idx")
  @@map("provider_received_cfdi_daily_summary")
}

model Sat69BBlacklistEntry {
  rfc             String   @id
  taxpayerName    String?  @map("taxpayer_name")
  statusLabel     String   @map("status_label")
  statusBucket    String   @map("status_bucket")
  isActiveRisk    Boolean  @default(false) @map("is_active_risk")
  publicationDate DateTime? @map("publication_date") @db.Date
  removalDate     DateTime? @map("removal_date") @db.Date
  sourceType      String   @default("SAT_69B") @map("source_type")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([statusBucket], map: "sat_69b_blacklist_entries_status_bucket_idx")
  @@index([isActiveRisk, rfc], map: "sat_69b_blacklist_entries_active_rfc_idx")
  @@index([lastSeenAt], map: "sat_69b_blacklist_entries_last_seen_idx")
  @@map("sat_69b_blacklist_entries")
}

