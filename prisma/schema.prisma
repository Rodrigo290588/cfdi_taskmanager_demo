generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  emailVerified         DateTime?              @map("email_verified")
  image                 String?
  password              String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  systemRole            SystemRole             @default(USER) @map("system_role")
  onboardingStep        String?                @default("initial")
  onboardingData        Json?                  @default("{}")
  accounts              Account[]
  apiKeys               ApiKey[]
  invoices              Invoice[]
  providerUploadedCfdis ProviderUploadedCfdi[] @relation("ProviderUploadedCfdiUser")
  satInvoices           SatInvoice[]
  memberships           Member[]
  organizations         Organization?
  sessions              Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Organization {
  id                                 String                             @id @default(cuid())
  name                               String
  slug                               String                             @unique
  logo                               String?
  description                        String?
  createdAt                          DateTime                           @default(now()) @map("created_at")
  updatedAt                          DateTime                           @updatedAt @map("updated_at")
  ownerId                            String?                            @unique
  onboardingCompleted                Boolean                            @default(false)
  setupRequirements                  Json                               @default("{\"minUsers\": 2, \"minCompanies\": 1}")
  operationalAccessEnabled           Boolean                            @default(false)
  systemSettings                     Json?                              @default("{}") @map("system_settings")
  address                            String?
  city                               String?
  state                              String?
  postalCode                         String?                            @map("postal_code")
  country                            String?                            @default("México")
  phone                              String?
  contactEmail                       String?                            @map("contact_email")
  businessDescription                String?                            @map("business_description")
  website                            String?
  industry                           String?
  companySize                        String?                            @map("company_size")
  foundedYear                        Int?                               @map("founded_year")
  taxId                              String?                            @map("tax_id")
  businessType                       String?                            @map("business_type")
  fiscalEntities                     FiscalEntity[]
  members                            Member[]
  machineClients                     MachineClient[]
  importRuns                         ImportRun[]
  importDirectorySessions            ImportDirectorySession[]
  providerUploadedCfdis              ProviderUploadedCfdi[]
  providerReceivedCfdiDailySummaries ProviderReceivedCfdiDailySummary[]
  invoicePaymentComplementDetails    InvoicePaymentComplementDetail[]
  invoiceIssuedDailySummaries        InvoiceIssuedDailySummary[]
  customRoles                        CustomRole[]
  companyAccesses                    CompanyAccess[]
  satCredentials                     SatCredential[]
  users                              User?                              @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([onboardingCompleted])
  @@index([operationalAccessEnabled])
  @@map("organizations")
}

model MachineClient {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  clientId         String       @unique @map("client_id")
  clientSecretHash String       @map("client_secret_hash")
  description      String?
  scopes           String[]     @default(["users:create"])
  allowedIps       String[]     @default([]) @map("allowed_ips")
  isActive         Boolean      @default(true) @map("is_active")
  expiresAt        DateTime?    @map("expires_at")
  lastUsedAt       DateTime?    @map("last_used_at")
  lastUsedIp       String?      @map("last_used_ip")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  createdByUserId  String?      @map("created_by_user_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("machine_clients")
}

model CustomRole {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  name                 String
  description          String?
  canViewEmission      Boolean  @default(true) @map("can_view_emission")
  canViewReception     Boolean  @default(true) @map("can_view_reception")
  canViewPayroll       Boolean  @default(true) @map("can_view_payroll")
  canViewSatPortal     Boolean  @default(true) @map("can_view_sat_portal")
  canViewMassDownloads Boolean  @default(true) @map("can_view_mass_downloads")
  canManageOrg         Boolean  @default(false) @map("can_manage_org")
  granularPermissions  Json?    @default("{}") @map("granular_permissions")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         Member[]
  companyAccesses CompanyAccess[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model Member {
  id                            String                 @id @default(cuid())
  userId                        String                 @map("user_id")
  organizationId                String                 @map("organization_id")
  role                          MemberRole             @default(VIEWER)
  customRoleId                  String?                @map("custom_role_id")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")
  status                        String                 @default("PENDING")
  approvedBy                    String?
  approvedAt                    DateTime?              @db.Timestamp(6)
  invitationTokenHash           String?                @map("invitation_token_hash")
  invitationExpiresAt           DateTime?              @db.Timestamp(6)
  organization                  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole                    CustomRole?            @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  companyAccesses               CompanyAccess[]
  providerUploadedCfdis         ProviderUploadedCfdi[]
  canViewEmission               Boolean                @default(true) @map("can_view_emission")
  canViewReception              Boolean                @default(true) @map("can_view_reception")
  canViewPayroll                Boolean                @default(true) @map("can_view_payroll")
  canViewSatPortal              Boolean                @default(true) @map("can_view_sat_portal")
  canViewMassDownloads          Boolean                @default(true) @map("can_view_mass_downloads")
  canManageOrg                  Boolean                @default(false) @map("can_manage_org")
  granularPermissions           Json?                  @default("{}") @map("granular_permissions")
  providerRfc                   String?                @map("provider_rfc")
  providerName                  String?                @map("provider_name")
  providerUploadBlockedAt       DateTime?              @map("provider_upload_blocked_at")
  providerUploadBlockedReason   String?                @map("provider_upload_blocked_reason")
  providerUploadBlockedBySystem Boolean                @default(false) @map("provider_upload_blocked_by_system")

  @@unique([userId, organizationId])
  @@index([invitationTokenHash])
  @@index([status])
  @@index([organizationId, providerRfc])
  @@index([providerUploadBlockedBySystem])
  @@map("members")
}

model FiscalEntity {
  id                              String                           @id @default(cuid())
  organizationId                  String                           @map("organization_id")
  rfc                             String                           @unique
  businessName                    String                           @map("business_name")
  taxRegime                       String                           @map("tax_regime")
  postalCode                      String                           @map("postal_code")
  isActive                        Boolean                          @default(true) @map("is_active")
  createdAt                       DateTime                         @default(now()) @map("created_at")
  updatedAt                       DateTime                         @updatedAt @map("updated_at")
  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices                        Invoice[]
  invoicePaymentComplementDetails InvoicePaymentComplementDetail[]
  invoiceIssuedDailySummaries     InvoiceIssuedDailySummary[]
  satInvoices                     SatInvoice[]

  @@map("fiscal_entities")
}

model Invoice {
  id                                String                           @id @default(cuid())
  userId                            String?                          @map("user_id")
  issuerFiscalEntityId              String                           @map("issuer_fiscal_entity_id")
  uuid                              String                           @unique
  cfdiType                          CfdiType                         @map("cfdi_type")
  series                            String?
  folio                             String?
  currency                          String                           @default("MXN")
  exchangeRate                      Float?                           @map("exchange_rate")
  status                            InvoiceStatus                    @default(ACTIVE)
  satStatus                         SatStatus                        @default(VIGENTE) @map("sat_status")
  issuerRfc                         String                           @map("issuer_rfc")
  issuerName                        String                           @map("issuer_name")
  receiverRfc                       String                           @map("receiver_rfc")
  receiverName                      String                           @map("receiver_name")
  subtotal                          Decimal                          @db.Decimal(15, 2)
  discount                          Decimal                          @default(0) @db.Decimal(15, 2)
  total                             Decimal                          @db.Decimal(15, 2)
  ivaTransferred                    Decimal                          @default(0) @map("iva_transferred") @db.Decimal(15, 2)
  ivaWithheld                       Decimal                          @default(0) @map("iva_withheld") @db.Decimal(15, 2)
  isrWithheld                       Decimal                          @default(0) @map("isr_withheld") @db.Decimal(15, 2)
  iepsWithheld                      Decimal                          @default(0) @map("ieps_withheld") @db.Decimal(15, 2)
  xmlContent                        String                           @map("xml_content")
  pdfUrl                            String?                          @map("pdf_url")
  issuanceDate                      DateTime                         @map("issuance_date")
  certificationDate                 DateTime                         @map("certification_date")
  certificationPac                  String                           @map("certification_pac")
  paymentMethod                     String                           @map("payment_method")
  paymentForm                       String                           @map("payment_form")
  cfdiUsage                         String                           @map("cfdi_usage")
  placeOfExpedition                 String                           @map("place_of_expedition")
  exportKey                         String                           @default("01") @map("export_key")
  objectTaxComprobante              String?                          @map("object_tax_comprobante")
  paymentConditions                 String?                          @map("payment_conditions")
  createdAt                         DateTime                         @default(now()) @map("created_at")
  updatedAt                         DateTime                         @updatedAt @map("updated_at")
  fiscalEntity                      FiscalEntity                     @relation(fields: [issuerFiscalEntityId], references: [id], onDelete: Cascade)
  user                              User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  concepts                          InvoiceConcept[]
  relatedCfdis                      InvoiceRelatedCfdi[]
  blob                              InvoiceBlob?
  complementIndex                   InvoiceComplementIndex?
  complementAttributes              InvoiceComplementAttribute[]
  paymentComplementDetailsAsPayment InvoicePaymentComplementDetail[] @relation("InvoicePaymentComplementDetailPaymentInvoice")
  paymentComplementDetailsAsRelated InvoicePaymentComplementDetail[] @relation("InvoicePaymentComplementDetailRelatedInvoice")

  @@index([issuerFiscalEntityId])
  @@index([issuerRfc])
  @@index([receiverRfc])
  @@index([issuanceDate])
  @@index([total])
  @@index([issuerFiscalEntityId, issuerRfc, issuanceDate], map: "invoices_issuer_fiscal_entity_rfc_date_idx")
  @@index([issuerRfc, paymentMethod, satStatus, issuanceDate], map: "invoices_issuer_rfc_payment_status_date_idx")
  @@index([issuerRfc, cfdiType, satStatus, issuanceDate], map: "invoices_issuer_rfc_type_status_date_idx")
  @@index([receiverRfc, cfdiType, satStatus, issuanceDate], map: "invoices_receiver_rfc_type_status_date_idx")
  @@map("invoices")
}

model InvoiceBlob {
  id               String   @id @default(cuid())
  invoiceId        String   @unique @map("invoice_id")
  xmlSha256        String   @map("xml_sha256")
  xmlCiphertext    String   @map("xml_ciphertext")
  xmlIv            String   @map("xml_iv")
  xmlAuthTag       String   @map("xml_auth_tag")
  xmlEncryptionAlg String   @map("xml_encryption_alg")
  xmlKeyVersion    String   @map("xml_key_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([xmlSha256], map: "invoice_blobs_xml_sha256_idx")
  @@map("invoice_blobs")
}

model InvoiceComplementIndex {
  id                      String   @id @default(cuid())
  invoiceId               String   @unique @map("invoice_id")
  hasPagos                Boolean  @default(false) @map("has_pagos")
  pagosVersion            String?  @map("pagos_version")
  hasNomina               Boolean  @default(false) @map("has_nomina")
  nominaVersion           String?  @map("nomina_version")
  hasCartaPorte           Boolean  @default(false) @map("has_carta_porte")
  cartaPorteVersion       String?  @map("carta_porte_version")
  hasComercioExterior     Boolean  @default(false) @map("has_comercio_exterior")
  comercioExteriorVersion String?  @map("comercio_exterior_version")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  invoice                 Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([hasPagos], map: "invoice_complement_index_has_pagos_idx")
  @@index([hasNomina], map: "invoice_complement_index_has_nomina_idx")
  @@index([hasCartaPorte], map: "invoice_complement_index_has_carta_porte_idx")
  @@index([hasComercioExterior], map: "invoice_complement_index_has_comercio_exterior_idx")
  @@map("invoice_complement_index")
}

model InvoiceComplementAttribute {
  id             String    @id @default(cuid())
  invoiceId      String    @map("invoice_id")
  complementType String    @map("complement_type")
  attributeKey   String    @map("attribute_key")
  valueText      String?   @map("value_text")
  valueNumber    Decimal?  @map("value_number") @db.Decimal(18, 6)
  valueDate      DateTime? @map("value_date")
  valueBoolean   Boolean?  @map("value_boolean")
  valueSearch    String?   @map("value_search")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "invoice_complement_attributes_invoice_id_idx")
  @@index([complementType, attributeKey], map: "invoice_complement_attributes_type_key_idx")
  @@index([attributeKey, valueSearch], map: "invoice_complement_attributes_key_search_idx")
  @@index([attributeKey, valueNumber], map: "invoice_complement_attributes_key_number_idx")
  @@map("invoice_complement_attributes")
}

model InvoicePaymentComplementDetail {
  id                   String       @id @default(cuid())
  organizationId       String       @map("organization_id")
  issuerFiscalEntityId String       @map("issuer_fiscal_entity_id")
  paymentInvoiceId     String       @map("payment_invoice_id")
  paymentInvoiceUuid   String       @map("payment_invoice_uuid")
  relatedInvoiceId     String?      @map("related_invoice_id")
  relatedInvoiceUuid   String       @map("related_invoice_uuid")
  paymentNodeIndex     Int          @default(1) @map("payment_node_index")
  paymentDate          DateTime     @map("payment_date")
  paymentSeries        String?      @map("payment_series")
  paymentFolio         String?      @map("payment_folio")
  montoTotalPagos      Decimal      @default(0) @map("monto_total_pagos") @db.Decimal(18, 6)
  baseP                Decimal      @default(0) @map("base_p") @db.Decimal(18, 6)
  importeP             Decimal      @default(0) @map("importe_p") @db.Decimal(18, 6)
  impPagado            Decimal      @default(0) @map("imp_pagado") @db.Decimal(18, 6)
  impSaldoAnt          Decimal      @default(0) @map("imp_saldo_ant") @db.Decimal(18, 6)
  impSaldoInsoluto     Decimal      @default(0) @map("imp_saldo_insoluto") @db.Decimal(18, 6)
  monedaP              String       @default("MXN") @map("moneda_p")
  monedaDR             String       @default("MXN") @map("moneda_dr")
  equivalenciaDR       Decimal      @default(1) @map("equivalencia_dr") @db.Decimal(18, 6)
  numParcialidad       Int          @default(1) @map("num_parcialidad")
  satStatusSnapshot    String       @default("SIN_ESTATUS") @map("sat_status_snapshot")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuerFiscalEntity   FiscalEntity @relation(fields: [issuerFiscalEntityId], references: [id], onDelete: Cascade)
  paymentInvoice       Invoice      @relation("InvoicePaymentComplementDetailPaymentInvoice", fields: [paymentInvoiceId], references: [id], onDelete: Cascade)
  relatedInvoice       Invoice?     @relation("InvoicePaymentComplementDetailRelatedInvoice", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, issuerFiscalEntityId, relatedInvoiceUuid], map: "invoice_payment_comp_entity_rel_uuid_idx")
  @@index([organizationId, issuerFiscalEntityId, paymentDate], map: "invoice_payment_comp_entity_pay_date_idx")
  @@index([paymentInvoiceId], map: "invoice_payment_comp_payment_inv_id_idx")
  @@index([relatedInvoiceId], map: "invoice_payment_comp_related_inv_id_idx")
  @@index([paymentInvoiceUuid, paymentNodeIndex], map: "invoice_payment_comp_uuid_node_idx")
  @@index([paymentInvoiceUuid, relatedInvoiceUuid, numParcialidad], map: "invoice_payment_comp_uuid_partiality_idx")
  @@map("invoice_payment_complement_details")
}

model InvoiceIssuedDailySummary {
  id                      String       @id @default(cuid())
  organizationId          String       @map("organization_id")
  issuerFiscalEntityId    String       @map("issuer_fiscal_entity_id")
  summaryDate             DateTime     @map("summary_date") @db.Date
  cfdiType                String       @map("cfdi_type")
  satStatus               String       @default("SIN_ESTATUS") @map("sat_status")
  receiverRfc             String       @default("") @map("receiver_rfc")
  receiverName            String       @default("") @map("receiver_name")
  paymentMethod           String       @default("") @map("payment_method")
  salesBucket             String       @default("NO_APLICA") @map("sales_bucket")
  paymentStatusBucket     String       @default("NO_APLICA") @map("payment_status_bucket")
  cfdiCount               Int          @default(0) @map("cfdi_count")
  subtotalAmount          Decimal      @default(0) @map("subtotal_amount") @db.Decimal(18, 6)
  discountAmount          Decimal      @default(0) @map("discount_amount") @db.Decimal(18, 6)
  totalAmount             Decimal      @default(0) @map("total_amount") @db.Decimal(18, 6)
  ivaTransferredTotal     Decimal      @default(0) @map("iva_transferred_total") @db.Decimal(18, 6)
  ivaWithheldTotal        Decimal      @default(0) @map("iva_withheld_total") @db.Decimal(18, 6)
  isrWithheldTotal        Decimal      @default(0) @map("isr_withheld_total") @db.Decimal(18, 6)
  iepsWithheldTotal       Decimal      @default(0) @map("ieps_withheld_total") @db.Decimal(18, 6)
  collectedAmount         Decimal      @default(0) @map("collected_amount") @db.Decimal(18, 6)
  pendingAmount           Decimal      @default(0) @map("pending_amount") @db.Decimal(18, 6)
  overdueAmount           Decimal      @default(0) @map("overdue_amount") @db.Decimal(18, 6)
  creditNoteAppliedAmount Decimal      @default(0) @map("credit_note_applied_amount") @db.Decimal(18, 6)
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuerFiscalEntity      FiscalEntity @relation(fields: [issuerFiscalEntityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, issuerFiscalEntityId, summaryDate, cfdiType, satStatus, receiverRfc, paymentMethod, salesBucket, paymentStatusBucket], map: "invoice_issued_daily_summary_unique_dim_idx")
  @@index([organizationId, issuerFiscalEntityId, summaryDate], map: "invoice_issued_daily_summary_entity_date_idx")
  @@index([organizationId, issuerFiscalEntityId, cfdiType], map: "invoice_issued_daily_summary_entity_type_idx")
  @@index([organizationId, issuerFiscalEntityId, receiverRfc], map: "invoice_issued_daily_summary_entity_receiver_idx")
  @@index([organizationId, issuerFiscalEntityId, salesBucket], map: "invoice_issued_daily_summary_entity_sales_bucket_idx")
  @@index([organizationId, issuerFiscalEntityId, paymentStatusBucket], map: "invoice_issued_daily_summary_entity_payment_bucket_idx")
  @@map("invoice_issued_daily_summary")
}

model SatInvoice {
  id                String        @id @default(cuid())
  userId            String?       @map("user_id")
  fiscalEntityId    String        @map("fiscal_entity_id")
  uuid              String        @unique
  cfdiType          CfdiType      @map("cfdi_type")
  series            String?
  folio             String?
  currency          String        @default("MXN")
  exchangeRate      Float?        @map("exchange_rate")
  status            InvoiceStatus @default(ACTIVE)
  satStatus         SatStatus     @default(VIGENTE) @map("sat_status")
  issuerRfc         String        @map("issuer_rfc")
  issuerName        String        @map("issuer_name")
  receiverRfc       String        @map("receiver_rfc")
  receiverName      String        @map("receiver_name")
  subtotal          Decimal       @db.Decimal(15, 2)
  discount          Decimal       @default(0) @db.Decimal(15, 2)
  total             Decimal       @db.Decimal(15, 2)
  ivaTrasladado     Decimal       @default(0) @map("iva_trasladado") @db.Decimal(15, 2)
  ivaRetenido       Decimal       @default(0) @map("iva_retenido") @db.Decimal(15, 2)
  isrRetenido       Decimal       @default(0) @map("isr_retenido") @db.Decimal(15, 2)
  iepsRetenido      Decimal       @default(0) @map("ieps_retenido") @db.Decimal(15, 2)
  xmlContent        String        @map("xml_content")
  pdfUrl            String?       @map("pdf_url")
  issuanceDate      DateTime      @map("issuance_date")
  certificationDate DateTime      @map("certification_date")
  certificationPac  String        @map("certification_pac")
  paymentMethod     String        @map("payment_method")
  paymentForm       String        @map("payment_form")
  usageCfdi         String        @map("usage_cfdi")
  expeditionPlace   String        @map("expedition_place")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  fiscalEntity      FiscalEntity  @relation(fields: [fiscalEntityId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fiscalEntityId])
  @@index([issuerRfc])
  @@index([receiverRfc])
  @@index([issuanceDate])
  @@index([total])
  @@map("sat_invoices")
}

model InvoiceConcept {
  id                   Int      @id @default(autoincrement())
  invoiceId            String   @map("invoice_id")
  productServiceKey    String   @map("product_service_key")
  identificationNumber String?  @map("identification_number")
  unitQuantity         Decimal  @map("unit_quantity") @db.Decimal(18, 6)
  unitKey              String   @map("unit_key")
  unitDescription      String?  @map("unit_description")
  description          String
  unitValue            Decimal  @map("unit_value") @db.Decimal(18, 6)
  amount               Decimal  @db.Decimal(18, 6)
  discount             Decimal  @default(0) @db.Decimal(15, 2)
  objectOfTax          String   @map("object_of_tax")
  transferredTaxesJson Json?    @map("transferred_taxes_json")
  withheldTaxesJson    Json?    @map("withheld_taxes_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_concepts")
}

model InvoiceRelatedCfdi {
  id           Int      @id @default(autoincrement())
  invoiceId    String   @map("invoice_id")
  relationType String   @map("relation_type")
  relatedUuid  String   @map("related_uuid")
  createdAt    DateTime @default(now()) @map("created_at")
