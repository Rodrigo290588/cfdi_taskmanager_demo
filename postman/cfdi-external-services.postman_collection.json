    {
      "name": "Importacion CFDI M2M",
      "description": "Solicitudes para importar CFDI por lote y consultar su avance usando el scope cfdi.import. Incluye tres variantes listas para prueba: emitido, recibido e intragrupo.",
      "item": [
        {
          "name": "1. Emitido",
          "description": "Flujo completo para un CFDI emitido: el RFC del Emisor debe pertenecer al tenant y el Receptor debe quedar fuera del tenant.",
          "item": [
            {
              "name": "1.1 Crear corrida emitido",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const xmlContent = pm.collectionVariables.get('cfdiImportXmlEmitido') || ''",
                      "const fileName = pm.collectionVariables.get('emitidoFileName') || 'emitido-prueba.xml'",
                      "const batchId = pm.collectionVariables.get('emitidoBatchId') || `postman-emitido-${Date.now()}`",
                      "",
                      "pm.expect(xmlContent).to.be.a('string')",
                      "pm.expect(xmlContent.trim().length).to.be.greaterThan(0)",
                      "",
                      "const contentBase64 = btoa(unescape(encodeURIComponent(xmlContent)))",
                      "const requestBody = {",
                      "  batchId,",
                      "  source: 'JAVA_M2M',",
                      "  items: [",
                      "    {",
                      "      fileName,",
                      "      contentBase64",
                      "    }",
                      "  ]",
                      "}",
                      "",
                      "pm.collectionVariables.set('emitidoBatchId', batchId)",
                      "pm.collectionVariables.set('cfdiImportRequestBody', JSON.stringify(requestBody, null, 2))"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 202', function () {",
                      "  pm.response.to.have.status(202)",
                      "})",
                      "",
                      "const data = pm.response.json()",
                      "",
                      "pm.test('Devuelve importRunId', function () {",
                      "  pm.expect(data.importRunId).to.be.a('string')",
                      "})",
                      "",
                      "if (data.importRunId) {",
                      "  pm.collectionVariables.set('emitidoImportRunId', data.importRunId)",
                      "  pm.collectionVariables.set('importRunId', data.importRunId)",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessTokenCfdiImport}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{{cfdiImportRequestBody}}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/external/cfdi-import",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "external",
                    "cfdi-import"
                  ]
                },
                "description": "Crea una corrida de prueba para un CFDI emitido usando la variable cfdiImportXmlEmitido."
              },
              "response": []
            },
            {
              "name": "1.2 Consultar resumen emitido",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', function () {",
                      "  pm.response.to.have.status(200)",
                      "})"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessTokenCfdiImport}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/external/cfdi-import/runs/{{emitidoImportRunId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "external",
                    "cfdi-import",
                    "runs",
                    "{{emitidoImportRunId}}"
                  ]
                },
                "description": "Consulta el resumen de la corrida del escenario emitido."
              },
              "response": []
            },
            {
              "name": "1.3 Consultar items emitido",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', function () {",
                      "  pm.response.to.have.status(200)",
                      "})"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessTokenCfdiImport}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/external/cfdi-import/runs/{{emitidoImportRunId}}/items?page={{importItemsPage}}&pageSize={{importItemsPageSize}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "external",
                    "cfdi-import",
                    "runs",
                    "{{emitidoImportRunId}}",
                    "items"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "{{importItemsPage}}"
                    },
                    {
                      "key": "pageSize",
                      "value": "{{importItemsPageSize}}"
                    }
                  ]
                },
                "description": "Consulta el detalle item por item del escenario emitido."
              },
              "response": []
            }
          ]
        },
