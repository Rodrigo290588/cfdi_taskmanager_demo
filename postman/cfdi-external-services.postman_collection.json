        {
          "name": "3. Intragrupo",
          "description": "Flujo completo para un CFDI intragrupo: tanto Emisor como Receptor pertenecen al tenant y debe persistir ambos lados.",
          "item": [
            {
              "name": "3.1 Crear corrida intragrupo",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const xmlContent = pm.collectionVariables.get('cfdiImportXmlIntragrupo') || ''",
                      "const fileName = pm.collectionVariables.get('intragrupoFileName') || 'intragrupo-prueba.xml'",
                      "const batchId = pm.collectionVariables.get('intragrupoBatchId') || `postman-intragrupo-${Date.now()}`",
                      "",
                      "pm.expect(xmlContent).to.be.a('string')",
                      "pm.expect(xmlContent.trim().length).to.be.greaterThan(0)",
                      "",
                      "const contentBase64 = btoa(unescape(encodeURIComponent(xmlContent)))",
                      "const requestBody = {",
                      "  batchId,",
                      "  source: 'JAVA_M2M',",
                      "  items: [",
                      "    {",
                      "      fileName,",
                      "      contentBase64",
                      "    }",
                      "  ]",
                      "}",
                      "",
                      "pm.collectionVariables.set('intragrupoBatchId', batchId)",
                      "pm.collectionVariables.set('cfdiImportRequestBody', JSON.stringify(requestBody, null, 2))"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 202', function () {",
                      "  pm.response.to.have.status(202)",
                      "})",
                      "",
                      "const data = pm.response.json()",
                      "",
                      "pm.test('Devuelve importRunId', function () {",
                      "  pm.expect(data.importRunId).to.be.a('string')",
                      "})",
                      "",
                      "if (data.importRunId) {",
                      "  pm.collectionVariables.set('intragrupoImportRunId', data.importRunId)",
                      "  pm.collectionVariables.set('importRunId', data.importRunId)",
                      "}"
                    ]
                  }
                }
