# =====================================================================
# .env.test  (Configuración AISLADA para tests Jest de seguridad SAST)
# NO contiene datos productivos.
# Recomendado: POSTGRES en Docker (docker compose up -d postgres-test redis)
# Puerto aislado 5434 (no colisiona con DEV 5433).
# =====================================================================

# --------- Runtime Node / Next -----------
NODE_ENV=test
PORT=3099

# --------- Base de Datos TEST (docker: postgres-test puerto 5434) ---------
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/platfi_intelligence_TEST_AUTH?schema=public&connect_timeout=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/platfi_intelligence_TEST_AUTH?schema=public&connect_timeout=10"

# --------- Redis (Queue Workers BullMQ · Cola Companies) ---------
REDIS_URL="redis://localhost:6379/15"  # DB 15 para aislar tests

# --------- Auth.js v5 · MÍNIMO 32 caracteres (AUTH-005 OWASP) ---------
NEXTAUTH_SECRET="sast-test-secret-REEMPLAZA_32+chars_random_crypto!!123"
AUTH_SECRET="sast-test-secret-REEMPLAZA_32+chars_random_crypto!!123"
AUTH_URL="http://localhost:3099"
NEXTAUTH_URL="http://localhost:3099"
AUTH_TRUST_HOST="true"
PUBLIC_HOSTS_ALLOWLIST="localhost:3099,127.0.0.1:3099,localhost:3000,127.0.0.1:3000"

# --------- Next App URL ---------
NEXT_PUBLIC_APP_URL="http://localhost:3099"

# --------- SAT 69-B Source (tests mock, no necesita acceso real) ---------
SAT_69B_SOURCE_URL="https://wu1agsprosta001.blob.core.windows.net/agsc-publicaciones/Datos_abiertos/Documents_AGAFF/Listado_completo_69-B.csv"

# --------- Provider CFDI (encriptación XMLs test, clave dummy) ---------
PROVIDER_CFDI_XML_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
PROVIDER_CFDI_XML_KEY_VERSION="v1-test"

# --------- M2M OAuth Clients (tests SAST - scopes coinciden .env.local) ---------
M2M_JWT_SECRET="7fALF9mTYqWDNXxBw#RJdcM@jUh1GlnkzaCt3Sy$)(%Ee"
M2M_JWT_ISSUER="cfdi-platform-test"
M2M_JWT_AUDIENCE="cfdi-external-users-test"
M2M_JWT_EXPIRES_IN="1m"
M2M_OAUTH_CLIENTS_JSON='[{"clientId":"sast-test-client","clientSecret":"sast-test-secret","organizationId":"cmnntrppk000502gcp93ketfx","scopes":["users:create","payments:update","cfdi.import","companies:read","companies:create"]}]'

# --------- Google Maps API Key (solo tests unitarios, no integración real) ---------
GOOGLE_API_KEY="test-google-api-key-placeholder"

# --------- SAST Tests FIXTURES (seed-sast-fixtures.mts IDs fijos) ---------
TEST_DEFAULT_ORG_ID="cmnntrppk000502gcp93ketfx"
TEST_ADMIN_USER_EMAIL="rtorreh@itcomplements.com"
TEST_OWNER_USER_EMAIL="sa-sast@itcomplements.com"
TEST_AUDITOR_USER_EMAIL="auditor-sast@itcomplements.com"
TEST_PASSWORD_MIN="Test_Passw0rd_123!"
TEST_OUTPUT_LOG_LEVEL="warn"  # silenciar logs error/warn en Jest

# --------- CFDI BATCH IMPORT (scope module /api/import SAFE limits SAST gate) ---------
EXTERNAL_CFDI_IMPORT_DEBUG_ENABLED=false
TEST_DEBUG_IMPORT_VERBOSE=false           # verbose invoice-import parse en Jest (off por default)
MAX_BATCH_SIZE_OVERRIDE=50                # hardcap anti DoS IMP-017 (50 recomendado vs 500 default)
MAX_XML_BYTES_OVERRIDE=5242880            # hardcap 5MB por CFDI vs 50MB default (OOM mitigation)
SAST_IMPORT_PAYLOADS_DIR="tests/import/fixtures"
SAT_CERT_PUBLIC_KEYS_DIR="fixtures/sat-certs-test"  # placeholder dir IMP-021 signature verify offline keys test

# --------- INVOICES API / PDF DOWNLOAD SAFE limits SAST INV gates (Puppeteer, rate-limit, file= dev) ---------
INVOICE_PDF_MAX_CONCURRENT_PAGES=5        # p-limit/semaphore max 5 tabs Chrome concurrentes (INV-012 DoS)
INVOICE_PDF_ENABLE_FILE_PARAM_IN_DEV=false # gate INV-003: por DEFAULT deshabilitado file= incluso en dev
INVOICE_PDF_MAX_XML_BYTES=5242880         # 5MB antes de pasar a Puppeteer (billion laughs INV-002 DoS 4GB OOM)
INVOICE_PDF_RATE_LIMIT_MAX_PER_HOUR=180   # hardcap 180 PDFs por usuario/hora (anti rate-limit bypass INV-006)
DEBUG_INVOICE_PDF_VERBOSE=false           # logs PII off por default (INV-004)

# --------- MASS-DOWNLOADS API SAFE limits SAST MD gates (SAT requests, BullMQ, AES whitelist) ---------
MASS_DOWNLOADS_ENABLE_FILE_DEBUG=false        # MD-001/MD-005 dev mode off por default
MASS_DOWNLOADS_RATE_MAX_PER_HOUR=30          # MD-003 anti DoS SAT solicitudes anónimas 30/hr
MASS_DOWNLOADS_FIEL_UPLOADS_MAX_PER_HOUR=5   # MD-004 fiel uploads 5/hr (mismo que INV rate)
MASS_DOWNLOADS_ZIP_MAX_BYTES=268435456       # 256 MB max paquete SAT
MASS_DOWNLOADS_EXPORT_CSV_MAX_ROWS=100000    # MD-008/MD-005 anti 1M row DoS en fiscal-control export
MASS_DOWNLOADS_CSV_INJECTION_QUOTE_PREFIX=true  # MD-005 apostrophe ante formula =, @, +, -
MASS_DOWNLOADS_REDIS_REQUIRE_AUTH=true       # MD-013 require REDIS_PASSWORD prod no empty
DATA_ENCRYPTION_KEY_REQUIRE_32_BYTES=true    # MD-007 NO passphrase < 32 bytes
