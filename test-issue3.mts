import dotenv from 'dotenv'; dotenv.config({ path: '.env.local' }); import { authenticateMachineClient, issueMachineToken, getMachineClientsFromEnv } from './src/lib/m2m-oauth'; async function run() { try { console.log('Clients:', getMachineClientsFromEnv()); const res = await authenticateMachineClient({ clientId: 'demo-client', clientSecret: 'demo-secret', requestedScopes: ['cfdi.import'] }); console.log('Auth:', res); if (res.ok) { const token = await issueMachineToken(res.client, res.scopes); console.log('Token:', token); } } catch (e) { console.error('ERROR:', e); } } run();